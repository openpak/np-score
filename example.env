NP_CORE_ADDR=localhost:7000
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!
NP_HTTP_ADDR=:8533
NP_LEADERBOARDS_ADDR=openpak-leaderboards:20211
NP_LEADERBOARDS_KEY=change-me-leaderboards-internal-key
NP_TICKET_KEY=/run/ps3/np-ticket-key.pem
# 20 bytes: firmware ranking resource key (VSH 0x684030 XOR 0x7F). Never commit it.
NP_RANKING_RESOURCE_KEY=/run/ps3/ranking-resource-key.bin
# Per-title passphrases and board settings (see README).
# NP_SCORE_TITLES=/run/ps3/score-titles.json
# Hosts the console is told to use; both must reach np-account (record over TLS, view over plain HTTP).
# NP_RANKING_RECORD_FQDN=ranking-record.np.community.playstation.net
# NP_RANKING_VIEW_FQDN=ranking-view.np.community.playstation.net
