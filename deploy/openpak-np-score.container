# Sample only. Copy to ~/.config/containers/systemd/openpak-np-score.container.
[Unit]
Description=OpenPak np-score

[Container]
ContainerName=openpak-np-score
Image=ghcr.io/openpak/np-score:latest
Network=openpak
EnvironmentFile=%h/openpak/deploy/np-score.env
Environment=NP_HTTP_ADDR=:8533
Volume=%h/openpak/deploy/ps3-keys:/run/ps3:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
